# ==========================================
# phpMyAdmin Environment Configuration
# ==========================================

# 32-character or longer encryption secret for cookie authentication
# Generate via: openssl rand -base64 32
PMA_BLOWFISH_SECRET=xampp

# Allow manual input of MySQL hostname on the login screen (true / false)
PMA_ARBITRARY=false

# HTTPS and Reverse Proxy (Cloudflare Tunnel / Coolify / Traefik)
PMA_IS_HTTPS=true
PMA_ABSOLUTE_URI=https://vince-larable-dbadmin.larable.dev/
PMA_COOKIE_SAMESITE=Lax
PMA_SESSION_SAVE_PATH=

# Appearance and Branding
PMA_THEME=boodark-orange
PMA_TITLE=Larable
PMA_TITLE_SERVER=
PMA_TITLE_DATABASE=
PMA_TITLE_TABLE=

# ------------------------------------------
# Server 1 Configuration (e.g. Local or Coolify Internal MySQL)
# ------------------------------------------
SERVER1_ENABLE=true
SERVER1_VERBOSE="Local MySQL"
SERVER1_HOST=127.0.0.1
SERVER1_PORT=3306
SERVER1_AUTH_TYPE=cookie
SERVER1_USER=root
SERVER1_PASSWORD=root
SERVER1_ALLOW_NO_PASSWORD=false
SERVER1_CONNECT_TYPE=tcp
SERVER1_SSL=false
SERVER1_SSL_VERIFY=false
SERVER1_HIDE_DB="^(information_schema|mysql|performance_schema|sys)$"

# Optional phpMyAdmin configuration storage database (pmadb)
SERVER1_PMADB=phpmyadmin
SERVER1_CONTROLUSER=root
SERVER1_CONTROLPASS=root

# ------------------------------------------
# Server 2 Configuration (e.g. Remote Aiven / Cloud MySQL)
# Set SERVER2_ENABLE=false or leave SERVER2_HOST empty to disable
# ------------------------------------------
SERVER2_ENABLE=true
SERVER2_VERBOSE="Larable Remote MySQL (Aiven)"
SERVER2_HOST=larable-mysql-service-larablenetwork-2db5.f.aivencloud.com
SERVER2_PORT=20707
SERVER2_AUTH_TYPE=cookie
SERVER2_USER=avnadmin
SERVER2_PASSWORD=AVNS_3c6BireRDm5jncJM3ke
SERVER2_CONNECT_TYPE=tcp
SERVER2_SSL=true
SERVER2_SSL_VERIFY=false
SERVER2_HIDE_DB="^(information_schema|mysql|performance_schema|sys)$"

# ------------------------------------------
# Generic / Single Server Shorthands (Optional alternative to SERVER1_*)
# If DB_HOST is set and SERVER1_HOST is not set, DB_HOST will be used.
# ------------------------------------------
# DB_HOST=
# DB_PORT=3306
# DB_USER=
# DB_PASSWORD=
# DB_VERBOSE=
